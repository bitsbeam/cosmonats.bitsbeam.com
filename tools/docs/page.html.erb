<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= ERB::Util.h(page.title) %> — Cosmonats docs</title>
  <meta name="description" content="<%= ERB::Util.h(page.description) %>">
  <meta name="theme-color" content="#060913">
  <link rel="icon" href="../assets/img/logo.svg" type="image/svg+xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;600&display=swap">
  <link rel="stylesheet" href="../assets/application.css">
  <script src="../assets/application.js" defer></script>
</head>
<body class="docs-page">
  <canvas class="starfield" data-starfield data-density="0.5" data-parallax="0.15" data-shooting-stars="false" aria-hidden="true"></canvas>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <header class="site-nav">
    <div class="brand">
      <a class="brand__home" href="../index.html" aria-label="Cosmonats home">
        <img class="brand__logo" src="../assets/img/logo.svg" alt="" width="38" height="38">
        <span class="brand__name">cosmonats</span>
      </a>
      <span class="brand__by">by <a href="https://bitsbeam.com/">bitsbeam</a></span>
    </div>
    <nav class="site-nav__links" aria-label="Primary">
      <a class="is-active" href="introduction.html" aria-current="page">docs</a>
      <a href="../index.html#blog">blog</a>
      <a class="pill-link" href="https://github.com/bitsbeam/cosmonats">GitHub ↗</a>
    </nav>
  </header>

  <div class="docs">
    <details class="docs-nav" open data-docs-nav>
      <summary class="docs-nav__toggle"><span class="eyebrow">Docs</span> <span class="docs-nav__current"><%= ERB::Util.h(page.title) %></span></summary>
      <nav aria-label="Documentation">
        <p class="docs-nav__version mono">cosmonats v<%= version %></p>
<% groups.each do |group, group_pages| -%>
        <p class="docs-nav__group"><%= group %></p>
        <ul class="docs-nav__list">
<% group_pages.each do |item| -%>
          <li><a href="<%= item.href %>"<%= ' class="is-active" aria-current="page"' if item == page %>><%= ERB::Util.h(item.title) %></a></li>
<% end -%>
        </ul>
<% end -%>
      </nav>
    </details>

    <main class="docs-main">
      <header class="docs-header">
        <span class="eyebrow eyebrow--orange"><%= page.group %></span>
        <h1 class="docs-title"><%= ERB::Util.h(page.title) %></h1>
      </header>

      <article class="post-body docs-body">
<%= page.body -%>
      </article>

      <p class="docs-edit mono"><a href="<%= edit_url %>">Edit this page on GitHub ↗</a></p>

      <nav class="post-pager docs-pager" aria-label="Previous and next page">
<% if previous_page -%>
        <a class="pager-card" href="<%= previous_page.href %>">
          <span class="pager-card__label">← Previous</span>
          <span class="pager-card__title"><%= ERB::Util.h(previous_page.title) %></span>
        </a>
<% else -%>
        <span></span>
<% end -%>
<% if next_page -%>
        <a class="pager-card pager-card--primary" href="<%= next_page.href %>">
          <span class="pager-card__label">Next →</span>
          <span class="pager-card__title"><%= ERB::Util.h(next_page.title) %></span>
        </a>
<% end -%>
      </nav>
    </main>

<% if page.headings.size > 1 -%>
    <aside class="docs-toc" aria-label="On this page">
      <p class="docs-nav__group">On this page</p>
      <ul class="docs-toc__list">
<% page.headings.each do |heading| -%>
        <li><a href="#<%= heading[:id] %>"><%= heading[:html] %></a></li>
<% end -%>
      </ul>
    </aside>
<% end -%>
  </div>

  <footer class="site-footer">
    <span>© 2026 <a href="https://bitsbeam.com">bitsbeam</a> · cosmonats is MIT licensed</span>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="https://github.com/bitsbeam/cosmonats">GitHub</a>
      <a href="https://rubygems.org/gems/cosmonats">RubyGems</a>
      <a href="../index.html">Home</a>
    </nav>
  </footer>
</body>
</html>
